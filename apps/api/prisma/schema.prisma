// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMIN
  COBRADOR
  CLIENTE
}

// Fase 3 — Crédito tiene 4 estados. ACTIVO/PAGADO/ANULADO son event-driven;
// MORA depende del tiempo y se cierra en la Fase 5 (cierre diario).
enum EstadoCredito {
  ACTIVO
  PAGADO
  MORA
  ANULADO
}

model Usuario {
  id           String   @id @default(uuid())
  nombre       String
  // Global, NO por tenant: el login (staff y portal) resuelve por documento.
  // Si fuera único por admin, `findUnique({ documento })` sería ambiguo.
  documento    String   @unique
  passwordHash String
  rol          Rol
  telefono     String?
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Multi-tenancy: el ADMIN es la raíz del tenant. Un COBRADOR pertenece a
  // exactamente un ADMIN (`adminId` apunta a él); un ADMIN tiene `adminId`
  // null porque es la raíz. Para resolver el tenant de cualquier usuario se
  // usa `resolveAdminId` (core/auth/tenant.util.ts): ADMIN → su propio id,
  // COBRADOR → su adminId.
  adminId    String?
  admin      Usuario?  @relation("AdminCobradores", fields: [adminId], references: [id], onDelete: Restrict)
  cobradores Usuario[] @relation("AdminCobradores")

  rutas Ruta[] @relation("CobradorRutas")
  pagos Pago[] // back-relation Fase 3 (cobrador persiste pagos)

  // Back-relations de propiedad (solo pobladas cuando el usuario es ADMIN).
  rutasAdmin     Ruta[]        @relation("AdminRutas")
  clientAdmins   ClientAdmin[] @relation("AdminClientes")
  productosAdmin Producto[]    @relation("AdminProductos")
  creditosAdmin  Credito[]     @relation("AdminCreditos")

  @@index([adminId])
}

model Ruta {
  id           String        @id @default(uuid())
  // Único POR ADMIN, no global: dos admins distintos deben poder tener cada
  // uno su "Ruta Centro" sin colisionar.
  nombre       String
  activa       Boolean       @default(true)
  cobradorId   String?
  cobrador     Usuario?      @relation("CobradorRutas", fields: [cobradorId], references: [id], onDelete: SetNull)
  // Dueño del tenant. Restrict: no se borra un admin que todavía tiene rutas.
  adminId      String
  admin        Usuario       @relation("AdminRutas", fields: [adminId], references: [id], onDelete: Restrict)
  // La asignación de ruta vive en `ClientAdmin` (por relación cliente↔admin),
  // no en `Cliente` directo — ver el comentario en `ClientAdmin`.
  clientAdmins ClientAdmin[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([adminId, nombre])
  @@index([cobradorId])
  @@index([adminId])
}

model Cliente {
  id                      String        @id @default(uuid())
  nombre                  String
  telefono                String
  documento               String        @unique
  direccion               String
  // Guardan el PATH dentro del bucket privado de Supabase, no una URL: el
  // bucket dejó de ser público (documentos de identidad), así que la URL
  // pública ya no existe — se firma al vuelo con expiración cuando se pide
  // el detalle del cliente (ver `StorageService.createSignedUrls`).
  fotoDocumentoFrentePath  String?
  fotoDocumentoReversoPath String?
  // Contacto de referencia (a quién llamar si no se ubica al cliente). Ambos
  // nullable e independientes: los clientes dados de alta antes de este campo
  // no lo tienen, y el alta no lo exige.
  contactoNombre          String?
  contactoTelefono        String?
  // Fase 4 — acceso opcional al portal del cliente. `passwordHash` null =
  // el staff aún no le generó credenciales (caso normal al dar de alta).
  // Cuando el staff genera/resetea el acceso, `passwordHash` se llena y
  // `mustChangePassword` se fuerza a true para que la temporal se cambie
  // en el primer ingreso. `passwordExpiresAt` caduca la temporal tras 24h.
  // Estos campos de login son GLOBALES (una sola cuenta por persona, sin
  // importar cuántos admins la tengan como cliente — ver `ClientAdmin`).
  passwordHash            String?
  mustChangePassword      Boolean       @default(false)
  passwordExpiresAt       DateTime?
  failedLoginAttempts     Int           @default(0)
  lockedUntil             DateTime?
  lastLoginAt             DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  // Multi-tenancy (v2): un Cliente es una identidad única (mismo documento,
  // mismo login) que puede pertenecer a VARIOS admins a la vez — cada
  // pertenencia es una fila `ClientAdmin`. `rutaId`/`activo` NO viven acá
  // porque son propiedad de la RELACIÓN admin↔cliente, no de la identidad:
  // dos admins que comparten un cliente asignan rutas distintas y pueden
  // desactivar su propia relación sin afectar al otro.
  admins ClientAdmin[]

  // Fase 3 — back-relation: 1 cliente → N créditos (posiblemente de admins
  // distintos si el cliente es compartido — cada Credito lleva su propio
  // `adminId`, ver el modelo).
  creditos Credito[]
}

// Relación cliente↔admin (soporta que un mismo Cliente sea cartera de más de
// un ADMIN). Es la única fuente de scoping por tenant para `Cliente`: un
// admin solo ve/gestiona los clientes con una fila acá para su `adminId`.
// `rutaId`/`activo` son POR RELACIÓN (no por cliente): el mismo Cliente puede
// estar en la ruta X del admin A y sin ruta en el admin B, o activo para uno
// e inactivo (soft-delete) para el otro.
model ClientAdmin {
  id        String   @id @default(uuid())
  clientId  String
  client    Cliente  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  adminId   String
  admin     Usuario  @relation("AdminClientes", fields: [adminId], references: [id], onDelete: Restrict)
  // Nullable: un cliente puede quedar "sin ruta" (bucket "Sin asignar") para
  // este admin sin dejar de ser su cliente. `onDelete: Restrict`: no se borra
  // una ruta que todavía tiene clientes asignados.
  rutaId    String?
  ruta      Ruta?    @relation(fields: [rutaId], references: [id], onDelete: Restrict)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, adminId])
  @@index([adminId])
  @@index([rutaId])
}

// Fase 3 — catálogo de productos. Nombre único → upsert idempotente del seed.
// Dinero siempre en Decimal, jamás Float (ver §3.6 del plan).
model Producto {
  id         String    @id @default(uuid())
  // Único POR ADMIN: cada admin lleva su propio catálogo. Con `@unique` global
  // el primer admin que registrara "Nevera" se lo bloqueaba a todos los demás.
  nombre     String
  precioBase Decimal   @db.Decimal(12, 2)
  activo     Boolean   @default(true)
  adminId    String
  admin      Usuario   @relation("AdminProductos", fields: [adminId], references: [id], onDelete: Restrict)
  creditos   Credito[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([adminId, nombre])
  @@index([adminId])
}

// Fase 3 — Crédito. `codigo` legible y único (CR-XXXX), generado en el service
// desde una secuencia de Postgres (`credito_codigo_seq`; race-safe).
// El alta envía `monto` (capital) + `interes` (%) + `dias`; el service DERIVA y
// materializa `montoTotal = monto + monto*interes/100` y `cuotaDiaria = montoTotal/dias`.
// `producto` es texto libre: el service registra el nombre en el catálogo
// (upsert) y enlaza por `productoId` (inventario). `saldoPendiente` se
// materializa al crear (= montoTotal) y se recalcula dentro de la transacción del
// cobro (ver §3.9 del plan). `estado` cambia por evento, excepto MORA que se
// deriva en lectura y se cierra con el cierre diario (Fase 5).
model Credito {
  id             String        @id @default(uuid())
  codigo         String        @unique
  clienteId      String
  cliente        Cliente       @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  productoId     String
  producto       Producto      @relation(fields: [productoId], references: [id], onDelete: Restrict)
  // Explícito, NO derivado de `cliente.adminId`: desde que un Cliente puede
  // ser cartera de varios admins (`ClientAdmin`), el tenant del crédito tiene
  // que quedar en el crédito mismo — si no, un crédito que el admin A le dio
  // a un cliente compartido sería visible también para el admin B con quien
  // ese cliente también tiene relación. Se exige que exista una fila
  // `ClientAdmin(clienteId, adminId)` al crear (el service lo valida).
  adminId        String
  admin          Usuario       @relation("AdminCreditos", fields: [adminId], references: [id], onDelete: Restrict)
  monto          Decimal       @db.Decimal(12, 2) // capital (sin interés)
  interes        Decimal       @db.Decimal(5, 2) // % de interés sobre el capital
  dias           Int // plazo en días = número de cuotas diarias
  montoTotal     Decimal       @db.Decimal(12, 2) // derivado = monto + monto*interes/100
  cuotaDiaria    Decimal       @db.Decimal(12, 2) // derivado = montoTotal/dias
  saldoPendiente Decimal       @db.Decimal(12, 2)
  estado         EstadoCredito @default(ACTIVO)
  fechaInicio    DateTime      @default(now())
  pagos          Pago[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([clienteId])
  @@index([adminId])
  @@index([estado])
}

// Fase 3 — Pago. Auditable: los registros de dinero no se borran (onDelete: Restrict).
// `reciboUrl` queda NULL en Fase 3; la Fase 4 lo llena (recibos).
model Pago {
  id         String   @id @default(uuid())
  creditoId  String
  credito    Credito  @relation(fields: [creditoId], references: [id], onDelete: Restrict)
  monto      Decimal  @db.Decimal(12, 2)
  fecha      DateTime @default(now())
  cobradorId String
  cobrador   Usuario  @relation(fields: [cobradorId], references: [id], onDelete: Restrict)
  reciboUrl  String?
  createdAt  DateTime @default(now())

  @@index([creditoId])
  @@index([cobradorId])
}
