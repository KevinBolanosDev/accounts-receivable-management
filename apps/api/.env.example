# Copia este archivo como .env y completa los valores reales.
# cp .env.example .env

# Puerto del servidor Nest (por defecto 3001 si no se define).
PORT=3001

# Origen permitido para CORS (la URL donde corre apps/web en dev).
WEB_ORIGIN=http://localhost:3000

# Cadena de conexión de Postgres de tu proyecto de Supabase.
# La encuentras en: Supabase > tu proyecto > Connect > Connection string (URI).
DATABASE_URL="postgresql://usuario:password@host:5432/postgres"
