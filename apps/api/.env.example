# Copia este archivo como .env y completa los valores reales.
# cp .env.example .env

# Puerto del servidor Nest (por defecto 3001 si no se define).
PORT=3001

# Origen permitido para CORS (la URL donde corre apps/web en dev).
WEB_ORIGIN=http://localhost:3000

# Cadena de conexión de Postgres de tu proyecto de Supabase.
# La encuentras en: Supabase > tu proyecto > Connect > Connection string (URI).
DATABASE_URL="postgresql://usuario:password@host:5432/postgres"

# Secreto para firmar los JWT de sesión (Fase 1). Generar uno propio con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="reemplaza-esto-con-un-secreto-aleatorio"

# Tiempo de expiración del token (formato de la librería `ms`: "1d", "12h", etc.).
JWT_EXPIRES_IN="1d"

# Supabase Storage: la service key se usa únicamente en el backend.
# IMPORTANTE: debe ser la `service_role` key (JWT que empieza con "eyJ...").
# La `sb_publishable_...`/anon key NO tiene permisos de escritura en el bucket.
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_SERVICE_KEY="reemplaza-esto-con-la-service-role-key"
SUPABASE_STORAGE_BUCKET="documentos"

# Fase 4 — URL pública de ESTE backend. Se usa para construir el enlace
# compartible del recibo (wa.me → ${PUBLIC_APP_URL}/payments/:pagoId/receipt).
PUBLIC_APP_URL=http://localhost:3001

# Fase 5 — cierre automático de rutas por cron (22:00 America/Bogota, ver
# core/reports/closure-policy.ts). Apagado por default: el cierre manual es
# el camino auditable, el cron es conveniencia. Poner en "true" para habilitarlo.
DAILY_CLOSURE_CRON_ENABLED=false
